# ---- Output sink ----
DISCORD_WEBHOOK_URL=

# ---- Cost formula (Nellis buyer's premium + sales tax) ----
PREMIUM=0.15
TAX=0.083

# ---- eBay resale economics ----
EBAY_FEE_RATE=0.1325
EBAY_FLAT_FEE=0.40
DEFAULT_SHIP_COST=6.00

# ---- Resale estimator (v2) ----
# RESALE_SOURCE: "ebay" pulls real eBay sold comps (median sold price, condition-
# adjusted) and falls back to the retail-haircut heuristic when a lot has too few
# comps. "heuristic" is the v1 retail-haircut only (no eBay traffic).
RESALE_SOURCE=heuristic
# Politeness for the eBay sold-search scrape (only the enriched shortlist is queried).
EBAY_REQUEST_INTERVAL_SECONDS=3.0
# Sold prices move slowly, so cache comps a full day.
EBAY_CACHE_TTL=86400
# Minimum number of sold comps required before trusting the median.
EBAY_MIN_COMPS=3

# ---- Verdict thresholds ----
TARGET_PROFIT=25
MIN_MARGIN_PCT=0.30

# ---- Sweep config ----
# Algolia "Taxonomy Level 2" facet values, comma-separated.
# Run `python -m nellis_hunter.feed --categories` to list valid values.
FLIP_CATEGORIES=Computers, Laptops, Tablets & Accessories|Monitors & Monitor Stands|Networking & Drives|Headphones|Speakers|Cameras & Photography Equipment
# Algolia "Location Name" facet values to sweep.
LOCATIONS=Phoenix|Mesa

# Location identifiers (discovered from the Nellis Algolia index — see NELLIS_API.md).
# These are the Algolia "Location Name" facet strings, not numeric IDs.
PHOENIX_LOCATION_ID=Phoenix
MESA_LOCATION_ID=Mesa

# ---- Politeness / scraping ----
# Minimum seconds between requests to nellisauction.com (detail pages).
REQUEST_INTERVAL_SECONDS=2.5
# Cache TTL for Algolia search results / lot details (seconds).
SEARCH_CACHE_TTL=3600
DETAIL_CACHE_TTL=1800
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) NellisHunter/0.1 (personal resale research; contact grantgibbons06@gmail.com)

# ---- Pipeline tuning ----
# Re-surface a previously seen lot if it closes within this many hours and is still under max_bid.
RESURFACE_WITHIN_HOURS=6
# How many top candidates to enrich with a per-lot detail fetch (current bid). Keeps the sweep polite.
MAX_DETAIL_FETCHES=60
# Max lots posted to the digest.
MAX_DIGEST_LOTS=25
